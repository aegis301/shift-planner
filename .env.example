POSTGRES_DB=shift_planner
POSTGRES_USER=shift_planner
POSTGRES_PASSWORD=shift_planner
POSTGRES_HOST_PORT=5433
FRONTEND_HOST_PORT=18130
BACKEND_HOST_PORT=18180
MCP_HOST_PORT=18181
DATABASE_URL=postgresql+psycopg://shift_planner:shift_planner@postgres:5432/shift_planner
SESSION_SECRET=change-me-to-a-long-random-secret
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=
PUBLIC_HOST=localhost
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
DEFAULT_ORGANIZATION_ID=1
TEAM_MEMBER_SEED_PASSWORD=change-me-team-members
PLANNER_SEED_EMAIL=
PLANNER_SEED_PASSWORD=change-me-planner
MCP_ADMIN_TOKEN=change-me-mcp-token
MCP_ORGANIZATION_ID=
BACKEND_CORS_ORIGINS=http://localhost:18130
NEXT_PUBLIC_API_BASE_URL=
API_PROXY_URL=http://backend:8000
ALLOWED_DEV_ORIGINS=localhost,planner.christianporschen.org
# Local Docker: leave NEXT_PUBLIC_API_BASE_URL empty; Next.js proxies /api to API_PROXY_URL (same-origin cookies).
# Direct API URL (split tunnel): set NEXT_PUBLIC_API_BASE_URL=https://your-api-host and SESSION_COOKIE_SECURE=true plus SESSION_COOKIE_DOMAIN=.your-domain
