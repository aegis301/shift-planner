# syntax=docker/dockerfile:1

FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json* .npmrc ./
COPY frontend/package.json frontend/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/domain/package.json packages/domain/package.json

RUN --mount=type=cache,target=/root/.npm \
    sh -eu -c '\
      for attempt in 1 2 3 4 5; do \
        npm ci --workspace frontend --include-workspace-root && exit 0; \
        echo "npm ci failed (attempt ${attempt}), retrying..."; \
        sleep $((attempt * 10)); \
      done; \
      exit 1 \
    '

COPY frontend frontend
COPY packages packages

ARG NEXT_PUBLIC_API_BASE_URL=
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL

RUN npm run build --workspace frontend

FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json* .npmrc ./
COPY frontend/package.json frontend/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/domain/package.json packages/domain/package.json

RUN --mount=type=cache,target=/root/.npm \
    sh -eu -c '\
      for attempt in 1 2 3 4 5; do \
        npm ci --omit=dev --workspace frontend --include-workspace-root && exit 0; \
        echo "npm ci failed (attempt ${attempt}), retrying..."; \
        sleep $((attempt * 10)); \
      done; \
      exit 1 \
    '

COPY --from=build /app/frontend/.next frontend/.next
COPY --from=build /app/frontend/public frontend/public
COPY --from=build /app/frontend/next.config.mjs frontend/next.config.mjs
COPY packages packages

EXPOSE 3000
CMD ["npm", "run", "start", "--workspace", "frontend"]
